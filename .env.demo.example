# Copy to .env on the demo VPS (gitignored). Fill every required value before compose up.
#   cp .env.demo.example .env && chmod 600 .env

# Application source clone (build + package dist must exist under this path)
UMBRACULUM_DEV_ROOT=/opt/umbraculum-dev

# Let's Encrypt (Traefik HTTP-01)
ACME_EMAIL=you@example.com

# Postgres (demo stack — single primary, no pgpool)
POSTGRES_PASSWORD=change-me-strong-random
DATABASE_URL=postgresql://postgres:change-me-strong-random@postgres:5432/brewapp

# API production secrets (generate on laptop: openssl rand -hex 32)
APP_AI_KEY_SECRET=
RENDERING_SIGNING_SECRET=

# Optional — override E2E seed passwords (see umbraculum-dev demo-host-runbook.md)
# E2E_ADMIN_PASSWORD=
# E2E_MEMBER_PASSWORD=
# E2E_VIEWER_PASSWORD=

UMBRACULUM_MODULE_PROFILE=reference

# Web demo shell notice is set in docker-compose.demo.yml (NEXT_PUBLIC_WEB_SHELL_NOTICE_ID=demo).
# Rebuild the web service after umbraculum-dev pulls that change i18n or WebShellNotice.
